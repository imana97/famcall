{
  "functions": [{ "source": "backend", "codebase": "famcall", "ignore": ["node_modules", ".git", "*-debug.log", ".env*", "src", "tsconfig.json"], "predeploy": ["npm run build:backend"] }],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": { "public": "website", "ignore": ["firebase.json", "**/.*", "**/node_modules/**"], "cleanUrls": true },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
