rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'phone'
        && request.auth.token.phone_number is string
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function call(id) { return get(/databases/$(database)/documents/calls/$(id)).data; }
    function participant(id) { return signedIn() && request.auth.uid in call(id).participants; }
    function active(id) {
      let c = call(id);
      return participant(id) && (
        (c.status == 'ringing' && request.time.toMillis() < c.ringExpiresAtMs) ||
        (c.status == 'accepted' && request.time.toMillis() < c.acceptedAtMs + 14400000)
      );
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow list, write: if false;
      match /contacts/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if false;
      }
      match /blocked/{id} { allow read: if owner(uid); allow write: if false; }
      match /devices/{id} { allow read, write: if false; }
    }
    match /activeCalls/{uid} { allow get: if owner(uid); allow list, write: if false; }
    match /calls/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
      match /signals/{uid} {
        allow read: if participant(id);
        allow create, update: if owner(uid) && active(id)
          && request.resource.data.keys().hasOnly(['type','sdp','generation'])
          && request.resource.data.generation is int
          && request.resource.data.generation > 0 && request.resource.data.generation <= 1000
          && request.resource.data.sdp is string && request.resource.data.sdp.size() <= 65536
          && ((uid == call(id).callerId && request.resource.data.type == 'offer')
              || (uid == call(id).calleeId && request.resource.data.type == 'answer'));
        allow delete: if false;
      }
      match /candidates/{candidateId} {
        allow read: if participant(id);
        allow create: if active(id)
          && request.resource.data.keys().hasOnly(['senderId','generation','candidate','sdpMid','sdpMLineIndex'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.generation is int
          && request.resource.data.generation > 0 && request.resource.data.generation <= 1000
          && request.resource.data.candidate is string && request.resource.data.candidate.size() <= 2048
          && request.resource.data.sdpMid is string && request.resource.data.sdpMid.size() <= 32
          && request.resource.data.sdpMLineIndex is int
          && request.resource.data.sdpMLineIndex >= 0 && request.resource.data.sdpMLineIndex <= 4;
        allow update, delete: if false;
      }
      match /restarts/{uid} {
        allow read: if participant(id);
        allow create, update: if owner(uid) && active(id)
          && request.resource.data.keys().hasOnly(['nonce'])
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() <= 64;
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
