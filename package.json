{
  "name": "famcall",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/mobile",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "build:backend": "npm run build --workspace=@famcall/backend",
    "mobile": "npm run start --workspace=@famcall/mobile"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "firebase": "13.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
